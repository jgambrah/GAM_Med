rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Specific rule for patient reports to allow patient read access
    match /hospitals/{hospitalId}/patient_reports/{patientId}/{fileName} {
      allow read: if request.auth.token.hospitalId == hospitalId || request.auth.uid == patientId;
      allow write: if request.auth.token.hospitalId == hospitalId;
    }

    // More specific rule for general hospital files, like logos etc.
    match /hospitals/{hospitalId}/assets/{fileName} {
       allow read: if true; // Publicly readable assets
       allow write: if request.auth.token.hospitalId == hospitalId;
    }

    // Fallback for any other hospital files
    match /hospitals/{hospitalId}/{path=**} {
      allow read, write: if request.auth.token.hospitalId == hospitalId;
    }
  }
}
